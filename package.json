{
  "name": "shadcn-digital-agency-jp",
  "version": "0.8.2",
  "private": true,
  "description": "Unofficial shadcn/ui native components inspired by the Digital Agency Design System.",
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "registry",
    "digital-agency",
    "design-system",
    "unofficial",
    "react",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "yukiharada1228",
  "type": "module",
  "packageManager": "npm@11.7.0",
  "scripts": {
    "demo": "vite --host 127.0.0.1",
    "demo:build": "vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "vitest run tests/a11y",
    "test:browser-a11y": "playwright test -c playwright.visual.config.ts tests/visual/accessibility.visual.spec.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts",
    "test:visual:parity": "playwright test -c playwright.visual.config.ts tests/visual/upstream-source-parity.visual.spec.ts tests/visual/upstream-source-behavior.visual.spec.ts tests/visual/forced-colors.visual.spec.ts tests/visual/demo-smoke.visual.spec.ts tests/visual/keyboard.visual.spec.ts tests/visual/narrow-viewport.visual.spec.ts",
    "test:visual:update": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "build": "npm run typecheck && npm run demo:build",
    "generate:theme": "tsx scripts/generate-theme.ts",
    "check:theme": "tsx scripts/generate-theme.ts --check",
    "check:upstream": "tsx scripts/check-upstream.ts",
    "diff:upstream": "tsx scripts/diff-upstream.ts",
    "registry:generate": "tsx scripts/generate-registry.ts",
    "registry:build": "tsx scripts/generate-registry.ts",
    "registry:test": "tsx scripts/generate-registry.ts --check",
    "license:sync": "tsx scripts/sync-license.ts",
    "license:check": "tsx scripts/check-license.ts"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-aria-components": "^1.22.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@digital-go-jp/design-tokens": "^2.0.1",
    "@digital-go-jp/tailwind-theme-plugin": "^1.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.59.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
